# Solana RPC endpoint. A free/public endpoint will rate-limit under real
# traffic — use a paid provider (Helius, Triton, etc.) before deploying.
RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
# Back-compat alias for RPC_URL, still read if RPC_URL is unset.
# DEVNET_RPC_URL=

# 'devnet' (default) or 'mainnet-beta'. Switches RPC program IDs, the CLMM
# AMM config, and which backing-assets file gets loaded — see solana.mjs and
# launch.mjs. Going to 'mainnet-beta' requires backing-assets.mainnet.json
# to be marked _verified: true first (deliberately refuses to boot otherwise).
CLUSTER=devnet

# Comma-separated list of origins allowed to call this API. Left unset, CORS
# is wide open — fine for local dev, not for a real deploy.
FRONTEND_ORIGIN=http://localhost:8000

# Platform wallet private key, as a JSON array string (e.g. what
# `JSON.stringify(Array.from(keypair.secretKey))` produces), meant to be
# injected by a secrets manager. If unset, falls back to reading
# devnet-wallet.json from disk (fine for local dev, not for production).
# PLATFORM_WALLET_SECRET=[1,2,3,...]

PORT=3000
